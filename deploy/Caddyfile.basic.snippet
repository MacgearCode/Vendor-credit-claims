# Add these blocks to the droplet's existing Caddyfile (the one that already serves n8n),
# then reload Caddy. Caddy obtains a Let's Encrypt cert for each hostname automatically
# once DNS points at the droplet.
#
# Auth is handled INSIDE the app (a styled /login page that checks the shared
# username/password from deploy/.env) — so there is no basic_auth block here.
# Caddy just terminates HTTPS and proxies through.
#
# `claims` below is the docker service name in docker-compose.basic.yml, not a hostname.
# Leave it as is — n8n posts to http://claims:8000 for the nightly pricing sync.

reporting.macgeargroup.com {
    reverse_proxy claims:8000
}

# Old names, kept as redirects — people have them bookmarked. {uri} preserves the
# path, so an old /promo/12 or /vendor-bills link still lands in the right place.
#   apps.macgeargroup.com    the site's name 2026-08-05 -> 2026-10 (became reporting)
#   promos.macgeargroup.com  the original name, until 2026-08-05
apps.macgeargroup.com {
    redir https://reporting.macgeargroup.com{uri} permanent
}

promos.macgeargroup.com {
    redir https://reporting.macgeargroup.com{uri} permanent
}

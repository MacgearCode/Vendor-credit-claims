# Copy to .env and fill in.  Used by docker-compose.basic.yml.
#
# The only value the compose file needs is the name of the docker network Caddy is on.
# Find it on the droplet with:
#   docker inspect $(docker ps --filter name=caddy -q) -f '{{json .NetworkSettings.Networks}}'
CADDY_NETWORK=root_default

# LEGACY SHARED LOGIN — the migration path and the break-glass way back in.
# While APP_PASSWORD is set, these credentials sign you in as an admin alongside
# the real per-user accounts managed at /admin/users. Blank it once your own
# admin account exists and you have confirmed you can sign in with it.
#
# Careful: if APP_PASSWORD is blank AND the users table is empty, auth is
# DISABLED entirely. Never deploy in that state.
APP_USERNAME=macgear
APP_PASSWORD=ChooseAStrongSharedPassword
# Secret that signs the login cookie. Generate with: openssl rand -hex 32
# Keep it stable — changing it signs everyone out. Don't commit the real value.
APP_SECRET=

# Public origin, used to build the single-use set-password links sent to new
# users. Behind Caddy the app would otherwise guess http://claims:8000 and the
# link would be unopenable. Set this whenever the app is deployed.
PUBLIC_BASE_URL=https://apps.macgeargroup.com

# Shared secret for the daily NetSuite pricing sync (n8n sends it in the X-Sync-Token
# header to POST /admin/sync-pricing). Generate one with: openssl rand -hex 24
# Leave blank to disable the sync endpoint entirely.
PRICING_SYNC_TOKEN=

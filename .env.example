# Copy to .env (gitignored) for local runs; run.ps1 loads it.
# Read-only warehouse role (reporting_read) - macgear_reporting on the DO cluster.
REPORTING_DB_URL=
# Targets tool: a role that owns / writes the `targets` schema in the same database.
# Unset = the Targets page says it isn't configured.
TARGETS_DB_URL=
# NetSuite account id (e.g. 1234567) - only builds "open in NetSuite" links on the GL
# Accounts pages; unset = no links. Not a credential.
NETSUITE_ACCOUNT_ID=
# Supporting documents (Brand Profitability PDFs) in DigitalOcean Spaces - a private bucket of
# its own, with a key scoped to that bucket. Unset = attaching PDFs is switched off.
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_REGION=syd1
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
